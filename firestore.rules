rules_version = '2';
// Everything lives under trips/{t}; only that trip's companions (trips/{t}.members, lower-case emails) can read or
// write it. Emails live in Firestore, not in this public repository.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // Site allowlist (who may sign in and use AI tools); each trip has its own member list.
    function siteMember() {
      return signedIn() && request.auth.token.email.lower()
        in get(/databases/$(database)/documents/config/members).data.emails;
    }
    function owned() {
      let d = request.resource.data;
      return d.by == request.auth.uid && d.byName is string && d.byName.size() <= 40
        && d.at is int && d.createdAt == request.time;
    }
    function expenseCat(v) { return v in ['food', 'transport', 'shopping', 'stay', 'fun', 'other']; }
    function day(v) { return v is int && v >= 1 && v <= 60; }
    function text(v, max) { return v is string && v.size() <= max; }
    // Booking documents uploaded to Storage (trips/{t}/docs/), listed on the hotel or flight.
    function docsValid(d) { return !('docs' in d) || (d.docs is list && d.docs.size() <= 6); }
    function hotelValid(d) {
      return d.keys().hasOnly(['name', 'address', 'checkIn', 'checkOut', 'mapsUrl', 'lat', 'lng', 'note', 'docs', 'by', 'byName', 'at', 'createdAt']) && docsValid(d)
        && text(d.name, 100) && d.name.size() > 0 && text(d.address, 200) && text(d.checkIn, 10) && text(d.checkOut, 10)
        && text(d.mapsUrl, 500) && text(d.note, 500)
        && (d.lat == null || d.lat is number) && (d.lng == null || d.lng is number);
    }
    function flightValid(d) {
      return d.keys().hasOnly(['flightNo', 'airline', 'from', 'to', 'depart', 'arrive', 'note', 'docs', 'by', 'byName', 'at', 'createdAt']) && docsValid(d)
        && text(d.flightNo, 20) && d.flightNo.size() > 0 && text(d.airline, 60) && text(d.from, 80) && text(d.to, 80)
        && text(d.depart, 20) && text(d.arrive, 20) && text(d.note, 500);
    }
    function shopValid(d) {
      return d.keys().hasOnly(['name', 'qty', 'detail', 'place', 'price', 'currency', 'photo', 'bought', 'boughtBy', 'boughtAt', 'ai', 'lat', 'lng', 'geoFor', 'by', 'byName', 'at', 'createdAt'])
        && (!('ai' in d) || d.ai is bool)
        && (!('lat' in d) || d.lat == null || d.lat is number) && (!('lng' in d) || d.lng == null || d.lng is number)
        && (!('geoFor' in d) || text(d.geoFor, 200))
        && text(d.name, 80) && d.name.size() > 0 && text(d.qty, 30) && text(d.detail, 500) && text(d.place, 200)
        && (d.price == null || (d.price is number && d.price >= 0 && d.price <= 10000000))
        && d.currency in ['JPY', 'HKD', 'KRW', 'TWD', 'THB', 'CNY', 'SGD', 'MYR', 'USD', 'EUR', 'GBP', 'AUD', 'CAD', 'VND', 'PHP', 'IDR']
        && (d.photo == null || text(d.photo, 400000))
        && d.bought is bool && (d.boughtBy == null || text(d.boughtBy, 40)) && (d.boughtAt == null || d.boughtAt is int);
    }

    match /config/{id} { allow read, write: if false; }

    // Trips: trips/{t}.members holds the lower-case emails of that trip's companions. Trip documents are
    // created and changed by the owner's tools for now; companions read their own trips (array-contains query).
    match /trips/{t} {
      function tripMember() {
        return signedIn() && request.auth.token.email.lower() in get(/databases/$(database)/documents/trips/$(t)).data.members;
      }
      allow read: if signedIn() && request.auth.token.email.lower() in resource.data.members;
      allow write: if false;


      // Trip data is uploaded with scripts/trip-data.mjs using the project owner's Google login.
      // Hotels and flights entered on the site (trips created on the site have no Sheet).
      match /hotels/{id} {
        allow read, delete: if tripMember();
        allow create: if tripMember() && owned() && hotelValid(request.resource.data);
        allow update: if tripMember() && hotelValid(request.resource.data) && request.resource.data.by == resource.data.by;
      }
      match /flights/{id} {
        allow read, delete: if tripMember();
        allow create: if tripMember() && owned() && flightValid(request.resource.data);
        allow update: if tripMember() && flightValid(request.resource.data) && request.resource.data.by == resource.data.by;
      }
      match /trip/{id} { allow read: if tripMember(); allow write: if false; }

      match /members/{uid} {
        allow read: if tripMember();
        allow write: if tripMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'email', 'at', 'saved'])
          && (!('saved' in request.resource.data) || (request.resource.data.saved is list && request.resource.data.saved.size() <= 500))
          && text(request.resource.data.name, 40) && request.resource.data.email == request.auth.token.email;
      }
      match /notes/{id} {
        allow read, delete: if tripMember();
        allow create: if tripMember() && owned()
          && request.resource.data.keys().hasOnly(['text', 'day', 'placeId', 'placeName', 'by', 'byName', 'at', 'createdAt'])
          && text(request.resource.data.text, 1000) && request.resource.data.text.size() > 0
          && (request.resource.data.day == null || day(request.resource.data.day))
          && (request.resource.data.placeId == null || text(request.resource.data.placeId, 10))
          && (request.resource.data.placeName == null || text(request.resource.data.placeName, 120));
      }
      match /expenses/{id} {
        allow read, delete: if tripMember();
        allow create: if tripMember() && owned()
          && request.resource.data.keys().hasOnly(['title', 'amount', 'currency', 'paidBy', 'split', 'day', 'items', 'receipts', 'receiptHashes', 'category', 'by', 'byName', 'at', 'createdAt'])
          && (!('category' in request.resource.data) || expenseCat(request.resource.data.category))
          && (!('receipts' in request.resource.data) || (request.resource.data.receipts is list && request.resource.data.receipts.size() <= 4))
          && (!('receiptHashes' in request.resource.data) || (request.resource.data.receiptHashes is list && request.resource.data.receiptHashes.size() <= 4))
          && (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 30))
          && text(request.resource.data.title, 80) && request.resource.data.title.size() > 0
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 10000000
          && request.resource.data.currency in ['JPY', 'HKD', 'KRW', 'TWD', 'THB', 'CNY', 'SGD', 'MYR', 'USD', 'EUR', 'GBP', 'AUD', 'CAD', 'VND', 'PHP', 'IDR']
          && request.resource.data.paidBy is string
          && request.resource.data.split is list && request.resource.data.split.size() > 0 && request.resource.data.split.size() <= 20
          && day(request.resource.data.day);
        // Only the category can be changed afterwards (any companion can sort an expense).
        allow update: if tripMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category'])
          && expenseCat(request.resource.data.category);
      }
      // Shared packing / pre-trip checklist; each companion ticks items for themselves (doneBy: their uids).
      function checkValid(d) {
        return text(d.text, 60) && d.text.size() > 0 && d.group in ['pre', 'pack', 'other']
          && d.doneBy is list && d.doneBy.size() <= 20;
      }
      match /checklist/{id} {
        allow read, delete: if tripMember();
        allow create: if tripMember() && owned()
          && request.resource.data.keys().hasOnly(['text', 'group', 'doneBy', 'by', 'byName', 'at', 'createdAt'])
          && checkValid(request.resource.data);
        allow update: if tripMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'group', 'doneBy'])
          && checkValid(request.resource.data);
      }
      // Exchange rates companions set by hand (home-currency units per 1 unit), shared by the whole trip.
      match /settings/{id} {
        allow read: if tripMember();
        allow write: if tripMember() && id == 'fx'
          && request.resource.data.keys().hasOnly(['rates', 'by', 'byName', 'at'])
          && request.resource.data.rates is map && request.resource.data.rates.size() <= 16
          && request.resource.data.by == request.auth.uid && text(request.resource.data.byName, 40) && request.resource.data.at is int;
      }
      function placeValid(d) {
        return d.keys().hasOnly(['base', 'fields', 'cats', 'lat', 'lng', 'points', 'mapsUrl', 'deleted', 'by', 'byName', 'at', 'createdAt'])
        && (!('points' in d) || (d.points is list && d.points.size() <= 10))
          && (d.base == null || text(d.base, 20)) && d.fields is list && d.fields.size() == 12
          && d.cats is list && d.cats.size() <= 4
          && (d.lat == null || d.lat is number) && (d.lng == null || d.lng is number)
          && text(d.mapsUrl, 500) && d.deleted is bool;
      }
      // Companion edits to 探索: new places, or edits/deletions keyed by the Sheet place id.
      match /places/{id} {
        allow read, delete: if tripMember();
        allow create: if tripMember() && owned() && placeValid(request.resource.data)
          && (request.resource.data.base == null || request.resource.data.base == id);
        allow update: if tripMember() && placeValid(request.resource.data) && request.resource.data.base == resource.data.base;
      }
      match /shopping/{id} {
        allow read, delete: if tripMember();
        allow create: if tripMember() && owned() && shopValid(request.resource.data);
        allow update: if tripMember() && shopValid(request.resource.data)
          && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at
          && request.resource.data.createdAt == resource.data.createdAt;
      }
      // Receipts and product photos read in the background by the processReceipt function; each companion sees only their own.
      match /receiptJobs/{id} {
        allow read, delete: if tripMember() && resource.data.by == request.auth.uid;
        allow create: if tripMember() && owned()
          && request.resource.data.keys().hasOnly(['image', 'images', 'hashes', 'kind', 'file', 'status', 'by', 'byName', 'at', 'createdAt'])
          && (!('hashes' in request.resource.data) || (request.resource.data.hashes is list && request.resource.data.hashes.size() <= 4))
          && request.resource.data.status == 'pending' && text(request.resource.data.file, 120)
          && (!('kind' in request.resource.data) || request.resource.data.kind in ['receipt', 'product', 'productFill'])
          && (('images' in request.resource.data && request.resource.data.images is list
                && request.resource.data.images.size() >= 1 && request.resource.data.images.size() <= 4)
              || text(request.resource.data.image, 900000));
        allow update: if tripMember() && resource.data.by == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['edit', 'status', 'retries', 'photos'])
          && (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending');
      }
      // Edited day plans: the whole stop list for one day (1-7); deleting the document restores the original plan.
      match /planDays/{day} {
        allow read, delete: if tripMember();
        allow write: if tripMember() && day.matches('^[1-9][0-9]?$') && int(day) <= 60
          && request.resource.data.keys().hasOnly(['stops', 'label', 'hotel', 'by', 'byName', 'at'])
          && (!('hotel' in request.resource.data) || text(request.resource.data.hotel, 40))
          && request.resource.data.stops is list && request.resource.data.stops.size() <= 40
          && (!('label' in request.resource.data) || text(request.resource.data.label, 40))
          && request.resource.data.by == request.auth.uid && text(request.resource.data.byName, 40) && request.resource.data.at is int;
      }
      match /stops/{id} {
        allow read, delete: if tripMember();
        allow create: if tripMember() && owned()
          && request.resource.data.keys().hasOnly(['day', 'time', 'title', 'detail', 'by', 'byName', 'at', 'createdAt'])
          && day(request.resource.data.day) && text(request.resource.data.time, 20)
          && text(request.resource.data.title, 80) && request.resource.data.title.size() > 0
          && text(request.resource.data.detail, 500);
      }
    }
  }
}

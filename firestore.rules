rules_version = '2';
// Only Google accounts listed in config/members (field "emails", an array) can read or write.
// The member emails live in Firestore, not in this public repository.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMember() {
      return signedIn() && request.auth.token.email.lower()
        in get(/databases/$(database)/documents/config/members).data.emails;
    }
    function owned() {
      let d = request.resource.data;
      return d.by == request.auth.uid && d.byName is string && d.byName.size() <= 40
        && d.at is int && d.createdAt == request.time;
    }
    function day(v) { return v is int && v >= 1 && v <= 7; }
    function text(v, max) { return v is string && v.size() <= max; }
    function shopValid(d) {
      return d.keys().hasOnly(['name', 'qty', 'detail', 'place', 'price', 'currency', 'photo', 'bought', 'boughtBy', 'boughtAt', 'by', 'byName', 'at', 'createdAt'])
        && text(d.name, 80) && d.name.size() > 0 && text(d.qty, 30) && text(d.detail, 500) && text(d.place, 200)
        && (d.price == null || (d.price is number && d.price >= 0 && d.price <= 10000000))
        && d.currency in ['JPY', 'HKD']
        && (d.photo == null || text(d.photo, 400000))
        && d.bought is bool && (d.boughtBy == null || text(d.boughtBy, 40)) && (d.boughtAt == null || d.boughtAt is int);
    }

    match /config/{id} { allow read, write: if false; }

    // Trip data is uploaded with scripts/trip-data.mjs using the project owner's Google login.
    match /trip/{id} { allow read: if isMember(); allow write: if false; }

    match /members/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
        && text(request.resource.data.name, 40) && request.resource.data.email == request.auth.token.email;
    }
    match /notes/{id} {
      allow read, delete: if isMember();
      allow create: if isMember() && owned()
        && request.resource.data.keys().hasOnly(['text', 'day', 'placeId', 'placeName', 'by', 'byName', 'at', 'createdAt'])
        && text(request.resource.data.text, 1000) && request.resource.data.text.size() > 0
        && (request.resource.data.day == null || day(request.resource.data.day))
        && (request.resource.data.placeId == null || text(request.resource.data.placeId, 10))
        && (request.resource.data.placeName == null || text(request.resource.data.placeName, 120));
    }
    match /expenses/{id} {
      allow read, delete: if isMember();
      allow create: if isMember() && owned()
        && request.resource.data.keys().hasOnly(['title', 'amount', 'currency', 'paidBy', 'split', 'day', 'items', 'by', 'byName', 'at', 'createdAt'])
        && (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 30))
        && text(request.resource.data.title, 80) && request.resource.data.title.size() > 0
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 10000000
        && request.resource.data.currency in ['JPY', 'HKD']
        && request.resource.data.paidBy is string
        && request.resource.data.split is list && request.resource.data.split.size() > 0 && request.resource.data.split.size() <= 20
        && day(request.resource.data.day);
    }
    function placeValid(d) {
      return d.keys().hasOnly(['base', 'fields', 'cats', 'lat', 'lng', 'mapsUrl', 'deleted', 'by', 'byName', 'at', 'createdAt'])
        && (d.base == null || text(d.base, 20)) && d.fields is list && d.fields.size() == 12
        && d.cats is list && d.cats.size() <= 4
        && (d.lat == null || d.lat is number) && (d.lng == null || d.lng is number)
        && text(d.mapsUrl, 500) && d.deleted is bool;
    }
    // Companion edits to 探索: new places, or edits/deletions keyed by the Sheet place id.
    match /places/{id} {
      allow read, delete: if isMember();
      allow create: if isMember() && owned() && placeValid(request.resource.data)
        && (request.resource.data.base == null || request.resource.data.base == id);
      allow update: if isMember() && placeValid(request.resource.data) && request.resource.data.base == resource.data.base;
    }
    match /shopping/{id} {
      allow read, delete: if isMember();
      allow create: if isMember() && owned() && shopValid(request.resource.data);
      allow update: if isMember() && shopValid(request.resource.data)
        && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Receipts read in the background by the processReceipt function; each companion sees only their own.
    match /receiptJobs/{id} {
      allow read, delete: if isMember() && resource.data.by == request.auth.uid;
      allow create: if isMember() && owned()
        && request.resource.data.keys().hasOnly(['image', 'file', 'status', 'by', 'byName', 'at', 'createdAt'])
        && request.resource.data.status == 'pending'
        && text(request.resource.data.image, 900000) && text(request.resource.data.file, 120);
      allow update: if isMember() && resource.data.by == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['edit', 'status', 'retries'])
        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending');
    }
    match /stops/{id} {
      allow read, delete: if isMember();
      allow create: if isMember() && owned()
        && request.resource.data.keys().hasOnly(['day', 'time', 'title', 'detail', 'by', 'byName', 'at', 'createdAt'])
        && day(request.resource.data.day) && text(request.resource.data.time, 20)
        && text(request.resource.data.title, 80) && request.resource.data.title.size() > 0
        && text(request.resource.data.detail, 500);
    }
  }
}
